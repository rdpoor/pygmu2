{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run python -c ' *)",
      "Bash(echo \"grep exit: $? \\(1 = clean\\)\")",
      "Bash(uv run *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(awk -F:: '{print $1}')",
      "Bash(git push *)",
      "Bash(git commit -q -m ' *)",
      "Bash(git diff *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(PYGMU_RENDER_MODE=profile uv run python -c ' *)"
    ]
  }
}
