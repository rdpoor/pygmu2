#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SEARCH_DIRS=("$REPO_ROOT/scripts" "$REPO_ROOT/examples")

# Load extra search dirs from .runpyg_paths (one path per line; # comments ok)
if [[ -f "$REPO_ROOT/.runpyg_paths" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"   # strip inline comments
    line="${line#"${line%%[![:space:]]*}"}"  # ltrim
    line="${line%"${line##*[![:space:]]}"}"  # rtrim
    [[ -z "$line" ]] && continue
    # Resolve relative paths against REPO_ROOT
    if [[ "$line" != /* ]]; then
      line="$REPO_ROOT/$line"
    fi
    SEARCH_DIRS+=("$line")
  done < "$REPO_ROOT/.runpyg_paths"
fi

usage() {
  cat <<'EOF'
Usage:
  scripts/runpyg <script_or_name> [demo_choice]

Examples:
  scripts/runpyg examples/23_convolution.py 4
  scripts/runpyg 23_convolution 4
  scripts/runpyg fluttersynth_midi
EOF
}

list_available() {
  for dir in "${SEARCH_DIRS[@]}"; do
    [ -d "$dir" ] || continue
    rel="${dir#$REPO_ROOT/}"
    echo "${rel}/"
    while IFS= read -r -d '' file; do
      base="$(basename "$file")"
      stem="${base%.py}"
      echo "  - $stem"
    done < <(find "$dir" -maxdepth 1 -type f -name '*.py' -print0 | sort -z)
  done
}

resolve_script() {
  local script_arg="$1"
  local candidate
  local matches=()
  local fuzzy_matches=()

  # Explicit or qualified path: use as-is.
  # Absolute paths are used directly.
  # Paths starting with ../ or ./ resolve from the caller's CWD.
  # Other slash-containing paths resolve from REPO_ROOT.
  if [[ "$script_arg" == /* || "$script_arg" == */* ]]; then
    if [[ "$script_arg" == /* ]]; then
      candidate="$script_arg"
    elif [[ "$script_arg" == ../* || "$script_arg" == ./* ]]; then
      candidate="$(pwd)/$script_arg"
    else
      candidate="$REPO_ROOT/$script_arg"
    fi
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    echo "Script path not found: $script_arg" >&2
    return 2
  fi

  local variants=("$script_arg")
  if [[ "$script_arg" != *.py ]]; then
    variants+=("${script_arg}.py")
  fi

  local dir variant probe
  for dir in "${SEARCH_DIRS[@]}"; do
    for variant in "${variants[@]}"; do
      probe="$dir/$variant"
      if [[ -f "$probe" ]]; then
        matches+=("$probe")
      fi
    done
  done

  if [[ ${#matches[@]} -eq 0 ]]; then
    # Fallback: simple substring match against script stems.
    local dir file base stem
    for dir in "${SEARCH_DIRS[@]}"; do
      [ -d "$dir" ] || continue
      for file in "$dir"/*.py; do
        [ -e "$file" ] || continue
        base="$(basename "$file")"
        stem="${base%.py}"
        if [[ "$stem" == *"$script_arg"* ]]; then
          fuzzy_matches+=("$file")
        fi
      done
    done
  fi

  if [[ ${#matches[@]} -eq 0 && ${#fuzzy_matches[@]} -eq 0 ]]; then
    echo "Could not find '$script_arg' in scripts/ or examples/." >&2
    return 2
  fi

  if [[ ${#matches[@]} -eq 0 && ${#fuzzy_matches[@]} -eq 1 ]]; then
    printf '%s\n' "${fuzzy_matches[0]}"
    return 0
  fi

  if [[ ${#matches[@]} -eq 0 && ${#fuzzy_matches[@]} -gt 1 ]]; then
    echo "Ambiguous script name via substring match. Please provide a path." >&2
    local fm rel
    for fm in "${fuzzy_matches[@]}"; do
      rel="${fm#$REPO_ROOT/}"
      echo "  - $rel" >&2
    done
    return 2
  fi
  if [[ ${#matches[@]} -gt 1 ]]; then
    echo "Ambiguous script name. Please provide a path." >&2
    local m rel
    for m in "${matches[@]}"; do
      rel="${m#$REPO_ROOT/}"
      echo "  - $rel" >&2
    done
    return 2
  fi

  printf '%s\n' "${matches[0]}"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  echo "Please provide a script name or path." >&2
  echo >&2
  usage >&2
  echo >&2
  echo "Available script names:" >&2
  list_available >&2
  exit 2
fi

script_arg="$1"
demo_choice="${2:-}"

if ! script_path="$(resolve_script "$script_arg")"; then
  echo >&2
  usage >&2
  exit 2
fi

cmd=(uv run python "$script_path")
if [[ -n "$demo_choice" ]]; then
  cmd+=("$demo_choice")
fi

echo "Running: ${cmd[*]}"
(
  cd "$REPO_ROOT"
  "${cmd[@]}"
)
